# Local development only. Copy to backend/.env and replace the JWT secret.
DATABASE_URL=postgres://ferxarp:ferxarp_local_only@localhost:5433/ferxarp
JWT_SECRET=replace_with_a_long_random_local_secret
FERXARP_SEED_PASSWORD=

# Solo para provisionar el administrador inicial con el CLI; quitar después de usar.
FERXARP_ADMIN_EMAIL=
FERXARP_ADMIN_PASSWORD=

# Optional integrations; leave empty when validating only PostgreSQL and the API.
GROQ_API_KEY=
# Chroma local published by Compose; inside Compose the backend uses http://chromadb:8000.
CHROMA_URL=http://localhost:8001
