{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            d.id, \n            d.title, \n            d.description, \n            d.quantity, \n            COALESCE(d.status, 'en_acopio') as \"status!\", \n            d.created_at, \n            u.email as donor_email\n        FROM donations d\n        JOIN users u ON d.user_id = u.id\n        WHERE d.status = 'en_acopio' OR d.status IS NULL\n        ORDER BY d.created_at DESC\n        LIMIT 50\n        ",
