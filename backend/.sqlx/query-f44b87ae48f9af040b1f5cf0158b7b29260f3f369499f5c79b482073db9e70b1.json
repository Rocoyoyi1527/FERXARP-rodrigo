  "query": "\n        SELECT r.id, r.ngo_id, r.status, n.is_verified\n        FROM donation_requests r\n        JOIN ngos n ON n.id = r.ngo_id\n        WHERE r.donation_id = $1\n        FOR UPDATE OF r, n\n        ",
